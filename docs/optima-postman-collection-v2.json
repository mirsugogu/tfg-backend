{
  "info": {
    "_postman_id": "optima-tfg-audit-2026",
    "name": "Optima API TFG (auditoria)",
    "description": "Coleccion completa tras la auditoria academica. Incluye los 6 audit checks con assertions automaticas. Variables: baseUrl (por defecto http://localhost:8084) y token (se rellena solo al hacer login). Para correr de un tiron: Collection Runner > Run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Recalcula fechas futuras (en hora LOCAL, no UTC) antes de cada request",
          "const now = new Date();",
          "const day = now.getDay();",
          "const pad = (n) => String(n).padStart(2, '0');",
          "const fmt = (d) => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;",
          "const setLocal = (k, d) => pm.collectionVariables.set(k, fmt(d));",
          "const nextDow = (target) => { const d = new Date(now); d.setDate(now.getDate() + (((target - day + 7) % 7) || 7)); return d; };",
          "const mon = nextDow(1); mon.setHours(10,0,0,0); setLocal('nextMon1000', mon);",
          "const mon1030 = new Date(mon); mon1030.setMinutes(30); setLocal('nextMon1030', mon1030);",
          "const mon1015 = new Date(mon); mon1015.setMinutes(15); setLocal('nextMon1015', mon1015);",
          "const mon1400 = new Date(mon); mon1400.setHours(14); setLocal('nextMon1400', mon1400);",
          "const wed = nextDow(3); wed.setHours(10,0,0,0); setLocal('nextWed1000', wed);",
          "const fri = nextDow(5); fri.setHours(23,0,0,0); setLocal('nextFri2300', fri);"
        ]
      }
    }
  ],
  "variable": [

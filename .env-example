# Convencion dotenv: valores SIN comillas. Docker Compose con `env_file`
# pasa el valor literal (las comillas pasarian como parte del string).

# JWT_SECRET: clave HMAC para firmar/validar tokens. OBLIGATORIA, sin
# fallback. Minimo 32 caracteres; con 48+ bytes el algoritmo se eleva
# automaticamente a HS384/HS512.
# Generar uno aleatorio fuerte:
#   PowerShell:
#     $b = New-Object byte[] 48
#     [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     [Convert]::ToBase64String($b)
#   Linux/Mac:
#     openssl rand -base64 48
# NUNCA reutilizar el mismo secret entre entornos (dev/staging/prod).
JWT_SECRET=
# JWT_EXPIRATION en milisegundos. 14400000 ms = 4 horas (limite duro).
JWT_EXPIRATION=14400000

# Gmail SMTP - requiere cuenta con 2FA y App Password de 16 caracteres
# Generar la App Password en: https://myaccount.google.com/apppasswords
# MAIL_USERNAME es el email completo (ej: optima.tfg@gmail.com)
# MAIL_PASSWORD es la App Password de 16 chars (Google la muestra como
#   "xxxx xxxx xxxx xxxx", quitar espacios).
MAIL_USERNAME=cambia-esto@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# URL del frontend. Se usa para construir el enlace del email de
# restablecer contrasena. Sin barra final. En local es el servidor Vite.
FRONTEND_URL=http://localhost:5173

# Habilita / deshabilita Swagger UI y el JSON OpenAPI.
# Default: true (util en desarrollo). En produccion poner false para
# reducir superficie de exposicion del API.
SWAGGER_ENABLED=true
# Convencion dotenv: valores SIN comillas. Docker Compose con `env_file`
# pasa el valor literal (las comillas pasarian como parte del string).
JWT_SECRET=EstaEsUnaClaveSuperSecretaYMuyLargaParaQueNoExplote2026!
JWT_EXPIRATION=86400000

# Gmail SMTP - requiere cuenta con 2FA y App Password de 16 caracteres
# Generar la App Password en: https://myaccount.google.com/apppasswords
# MAIL_USERNAME es el email completo (ej: optima.tfg@gmail.com)
# MAIL_PASSWORD es la App Password de 16 chars (Google la muestra como
#   "xxxx xxxx xxxx xxxx", quitar espacios).
MAIL_USERNAME=cambia-esto@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# URL del frontend. Se usa para construir el enlace del email de
# restablecer contrasena. Sin barra final. En local es el servidor Vite.
FRONTEND_URL=http://localhost:5173